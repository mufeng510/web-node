{
  "name": "web-note",
  "version": "0.1.0",
  "description": "Browser-first, Self-hosted, Markdown-first, Obsidian-compatible, AI-native personal knowledge base",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run scripts/build.ts",
    "start": "bun run dist/index.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/db:migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run scripts/db:seed.ts",
    "openapi:generate": "bun run scripts/generate:openapi.ts",
    "types:generate": "bun run scripts/generate:types.ts",
    "fnos:package": "bun run scripts/fnos:package.ts",
    "docker:build": "docker buildx build --platform linux/amd64,linux/arm64 -t web-note .",
    "docker:build:local": "docker build -t web-note:local ."
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.0",
    "@libsql/client": "^0.14.0",
    "@tanstack/react-query": "^5.59.0",
    "@tiptap/extension-code-block-lowlight": "^2.9.0",
    "@tiptap/extension-collaboration": "^2.9.0",
    "@tiptap/extension-collaboration-cursor": "^2.9.0",
    "@tiptap/extension-highlight": "^2.9.0",
    "@tiptap/extension-image": "^2.9.0",
    "@tiptap/extension-link": "^2.9.0",
    "@tiptap/extension-placeholder": "^2.9.0",
    "@tiptap/extension-table": "^2.9.0",
    "@tiptap/extension-table-cell": "^2.9.0",
    "@tiptap/extension-table-header": "^2.9.0",
    "@tiptap/extension-table-row": "^2.9.0",
    "@tiptap/extension-task-item": "^2.9.0",
    "@tiptap/extension-task-list": "^2.9.0",
    "@tiptap/extension-typography": "^2.9.0",
    "@tiptap/pm": "^2.9.0",
    "@tiptap/react": "^2.9.0",
    "@tiptap/starter-kit": "^2.9.0",
    "argon2": "^0.41.1",
    "axios": "^1.20.0",
    "better-sqlite3": "^11.5.0",
    "chokidar": "^4.0.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "lucide-react": "^0.460.0",
    "marked": "^15.0.0",
    "mermaid": "^11.4.0",
    "nanoid": "^5.0.7",
    "openapi3-ts": "^4.3.0",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.34.0",
    "react-router-dom": "^7.18.4",
    "simple-git": "^3.27.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "tailwind-merge": "^2.5.0",
    "uuid": "^10.0.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@playwright/test": "^1.48.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@types/yaml": "^1.9.7",
    "@vitejs/plugin-react": "5.0.0",
    "drizzle-kit": "^0.31.0",
    "jsdom": "^30.0.1",
    "lowlight": "^3.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-static-copy": "^1.0.0",
    "vitest": "^2.1.0"
  },
  "trustedDependencies": ["@biomejs/biome", "argon2", "better-sqlite3", "playwright"],
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.1.0"
}
